# Copy to .env for local result updates. Get a free token at:
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_token_here

# Optional overrides (defaults shown). COMP "WC" = FIFA World Cup.
# FOOTBALL_DATA_COMP=WC
# FOOTBALL_DATA_SEASON=2026   # leave unset to use the competition's current season

# Optional: YouTube highlights for finished matches. Get a key from Google Cloud
# Console (enable "YouTube Data API v3"). Without it, highlights are simply skipped.
# YOUTUBE_API_KEY=your_key_here
# YOUTUBE_SEARCH_BUDGET=4     # max YouTube searches per run (100 units each / 10k daily)
# YOUTUBE_MAX_AGE_DAYS=5      # only look for highlights for matches finished this recently

# Optional: Cloudflare Web Analytics (page views). Create a site token in the Cloudflare
# dashboard -> Analytics & Logs -> Web Analytics -> Add a site, then set it as the repo
# Actions *variable* VITE_CF_BEACON_TOKEN (not a secret — it's public). The beacon only
# loads in production builds when this is set; dev never sends page views.
# VITE_CF_BEACON_TOKEN=your_site_token
