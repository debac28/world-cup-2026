{
  "name": "worldcup26",
  "version": "1.0.0",
  "description": "FIFA World Cup 2026 schedule, scores, standings & top scorers — installable PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "python3 scripts/extract_seed.py",
    "update": "node --env-file-if-exists=.env scripts/update_results.mjs",
    "status": "node scripts/status.mjs",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "worker:secret": "wrangler secret put FOOTBALL_DATA_TOKEN -c worker/wrangler.toml"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "wrangler": "^3.80.0"
  }
}
